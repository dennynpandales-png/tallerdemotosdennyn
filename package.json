{
  "name": "hidep-soft",
  "version": "1.0.0",
  "description": "Sistema de Gestion Taller de Motos",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.6.4",
    "electron-rebuild": "^3.2.9"
  },
  "dependencies": {
    "express": "^5.3.0",
    "sqlite3": "^5.1.7"
  },
  "build": {
    "npmRebuild": false,
    "appId": "com.hidepsoft.taller",
    "productName": "HIDEP-SOFT",
    "directories": {
      "output": "dist"
    },
    "win": {
      "icon": "public/icon.ico",
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "asar": true,
    "asarUnpack": [
      "**/*.node"
    ],
    "files": [
      "main.js",
      "server.js",
      "public/**/*",
      "database.db"
    ],
    "extraResources": [
      "database.db"
    ]
  },
  "allowScripts": {
    "electron@28.3.3": true,
    "sqlite3@5.1.7": true,
    "lzma-native@8.0.6": true
  }
}
